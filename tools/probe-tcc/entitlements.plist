<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Intentionally empty for v1 (Scenario A: ad-hoc signing).
        Without Hardened Runtime we do not need entitlements.

        If we ever migrate to Hardened Runtime (paid Apple Developer Program
        signing), entitlements that may need adding:
          com.apple.security.cs.allow-jit          (if linking JIT)
          com.apple.security.cs.disable-library-validation
                                                   (if linking 3rd-party dylibs)
    -->
</dict>
</plist>
